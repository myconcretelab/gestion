generator client {
  provider = "prisma-client-js"
}

generator postgres_client {
  provider = "prisma-client-js"
  output   = "../generated/postgres-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id
  slug      String   @unique
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings              OrganizationSettings?
  memberships           Membership[]
  runtime_settings      OrganizationRuntimeSetting[]
  jobs                  OrganizationJob[]
  job_attempts          OrganizationJobAttempt[]
  audit_logs            AuditLog[]
  document_assets       DocumentAsset[]
  subscriptions         Subscription[]
  entitlement_overrides OrganizationEntitlementOverride[]
  usage_counters        UsageCounter[]
  usage_events          UsageEvent[]
  billing_events        BillingEvent[]
  task_leases           OrganizationTaskLease[]

  @@map("organizations")
}

model User {
  id                  String    @id
  login_id            String    @unique
  email               String?   @unique
  password_hash       String?
  password_salt       String?
  password_updated_at DateTime?
  auth_version        Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  memberships            Membership[]
  profiles               AppUser[]
  platform_administrator PlatformAdministrator?

  @@map("users")
}

model Membership {
  id              String    @id @default(cuid())
  user_id         String
  organization_id String
  role            String    @default("custom")
  status          String    @default("active")
  permissions     Json      @default("{}")
  invited_at      DateTime?
  accepted_at     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([user_id, organization_id], map: "memberships_user_organization_key")
  @@index([organization_id, status], map: "memberships_organization_status_idx")
  @@map("memberships")
}

model OrganizationSettings {
  organization_id String   @id
  profile_json    Json     @default("{}")
  locale          String   @default("fr-FR")
  currency        String   @default("EUR")
  timezone        String   @default("Europe/Paris")
  branding_json   Json     @default("{}")
  documents_json  Json     @default("{}")
  modules_json    Json     @default("{}")
  setup_completed Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model OrganizationRuntimeSetting {
  id              String   @id @default(cuid())
  organization_id String
  key             String
  version         Int      @default(1)
  value_json      Json     @default("{}")
  is_secret       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, key], map: "organization_runtime_settings_org_key")
  @@map("organization_runtime_settings")
}

model OrganizationJob {
  id              String    @id @default(cuid())
  organization_id String
  type            String
  payload_json    Json      @default("{}")
  status          String    @default("queued")
  attempts        Int       @default(0)
  run_at          DateTime  @default(now())
  locked_at       DateTime?
  lock_owner      String?
  last_error      String?
  idempotency_key String
  createdAt       DateTime  @default(now())
  completed_at    DateTime?

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  attempt_runs OrganizationJobAttempt[]

  @@unique([organization_id, idempotency_key], map: "organization_jobs_org_idempotency_key")
  @@index([organization_id, status, run_at], map: "organization_jobs_org_status_run_idx")
  @@map("organization_jobs")
}

model OrganizationJobAttempt {
  id              String          @id @default(cuid())
  organization_id String
  job_id          String
  attempt         Int
  status          String
  result_json     Json            @default("{}")
  error_message   String?
  started_at      DateTime        @default(now())
  completed_at    DateTime?
  organization    Organization    @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  job             OrganizationJob @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@unique([job_id, attempt], map: "organization_job_attempts_job_attempt_key")
  @@index([organization_id, status, started_at], map: "organization_job_attempts_org_status_idx")
  @@map("organization_job_attempts")
}

model AuditLog {
  id              String   @id @default(cuid())
  organization_id String
  user_id         String?
  request_id      String?
  action          String
  resource_type   String
  resource_id     String?
  metadata_json   Json     @default("{}")
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, createdAt], map: "audit_logs_org_created_idx")
  @@index([organization_id, resource_type, resource_id], map: "audit_logs_org_resource_idx")
  @@map("audit_logs")
}

model DocumentAsset {
  id              String    @id @default(cuid())
  organization_id String
  storage_key     String
  legacy_path     String?
  content_type    String
  size_bytes      BigInt
  checksum_sha256 String
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  deleted_at      DateTime?

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, storage_key], map: "document_assets_org_storage_key")
  @@index([organization_id, status], map: "document_assets_org_status_idx")
  @@map("document_assets")
}

model Plan {
  id              String            @id @default(cuid())
  code            String            @unique
  name            String
  description     String            @default("")
  billing_periods Json              @default("[]")
  status          String            @default("active")
  public_metadata Json              @default("{}")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  entitlements    PlanEntitlement[]
  subscriptions   Subscription[]
  billing_prices  BillingPrice[]

  @@map("plans")
}

model PlanEntitlement {
  id            String   @id @default(cuid())
  plan_id       String
  feature_key   String
  value_boolean Boolean?
  limit_value   Int?
  limit_type    String   @default("hard")
  plan          Plan     @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@unique([plan_id, feature_key], map: "plan_entitlements_plan_feature_key")
  @@map("plan_entitlements")
}

model BillingPrice {
  id                  String   @id @default(cuid())
  plan_id             String
  provider            String
  provider_product_id String
  provider_price_id   String
  billing_period      String
  status              String   @default("active")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  plan                Plan     @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_price_id], map: "billing_prices_provider_price_key")
  @@unique([plan_id, provider, billing_period], map: "billing_prices_plan_provider_period_key")
  @@index([provider, provider_product_id], map: "billing_prices_provider_product_idx")
  @@map("billing_prices")
}

model Subscription {
  id                       String         @id @default(cuid())
  organization_id          String
  plan_id                  String
  status                   String         @default("active")
  trial_start              DateTime?
  trial_end                DateTime?
  current_period_start     DateTime?
  current_period_end       DateTime?
  cancel_at_period_end     Boolean        @default(false)
  cancelled_at             DateTime?
  grace_period_end         DateTime?
  provider                 String?
  provider_customer_id     String?
  provider_subscription_id String?
  sync_version             Int            @default(0)
  last_synced_at           DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  organization             Organization   @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  plan                     Plan           @relation(fields: [plan_id], references: [id], onDelete: Restrict)
  events                   BillingEvent[]

  @@unique([organization_id], map: "subscriptions_organization_key")
  @@unique([provider, provider_customer_id], map: "subscriptions_provider_customer_key")
  @@unique([provider, provider_subscription_id], map: "subscriptions_provider_subscription_key")
  @@index([status], map: "subscriptions_status_idx")
  @@map("subscriptions")
}

model OrganizationEntitlementOverride {
  id              String       @id @default(cuid())
  organization_id String
  feature_key     String
  value_boolean   Boolean?
  limit_value     Int?
  reason          String
  expires_at      DateTime?
  author_user_id  String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id, feature_key, expires_at], map: "entitlement_overrides_lookup_idx")
  @@map("organization_entitlement_overrides")
}

model UsageCounter {
  id              String       @id @default(cuid())
  organization_id String
  metric_key      String
  period_key      String
  value           Int          @default(0)
  source          String       @default("computed")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, metric_key, period_key], map: "usage_counters_org_metric_period_key")
  @@map("usage_counters")
}

model UsageEvent {
  id              String       @id @default(cuid())
  organization_id String
  metric_key      String
  period_key      String
  amount          Int          @default(1)
  idempotency_key String
  source          String
  metadata_json   Json         @default("{}")
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, idempotency_key], map: "usage_events_org_idempotency_key")
  @@index([organization_id, metric_key, period_key], map: "usage_events_org_metric_period_idx")
  @@map("usage_events")
}

model BillingEvent {
  id                String        @id @default(cuid())
  organization_id   String
  subscription_id   String?
  provider          String
  provider_event_id String
  type              String
  payload_reference String?
  payload_json      Json          @default("{}")
  idempotency_key   String
  status            String        @default("received")
  result            String?
  error_message     String?
  received_at       DateTime      @default(now())
  processed_at      DateTime?
  createdAt         DateTime      @default(now())
  organization      Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  subscription      Subscription? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)

  @@unique([provider, provider_event_id], map: "billing_events_provider_event_key")
  @@unique([provider, idempotency_key], map: "billing_events_provider_idempotency_key")
  @@index([organization_id, received_at], map: "billing_events_org_received_idx")
  @@map("billing_events")
}

model PlatformAdministrator {
  user_id   String   @id
  role      String   @default("billing_admin")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("platform_administrators")
}

model PlatformAdministratorEvent {
  id            String   @id @default(cuid())
  user_id       String
  actor_user_id String?
  action        String
  reason        String
  createdAt     DateTime @default(now())

  @@index([user_id, createdAt], map: "platform_admin_events_user_created_idx")
  @@map("platform_administrator_events")
}

model OrganizationTaskLease {
  id               String        @id @default(cuid())
  organization_id  String
  task_key          String
  lease_owner       String?
  lease_expires_at  DateTime?
  last_started_at   DateTime?
  last_succeeded_at DateTime?
  last_failed_at    DateTime?
  last_error        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  organization      Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, task_key], map: "organization_task_leases_org_task_key")
  @@index([task_key, lease_expires_at], map: "organization_task_leases_task_expiry_idx")
  @@map("organization_task_leases")
}

model InstallationConfig {
  id                String   @id @default("default")
  organization_json String   @default("{}")
  modules_json      String   @default("{}")
  setup_completed   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  organization_id   String   @default("org_historical_broceliande")

  @@map("installation_config")
}

model ContentTemplateVersion {
  id              String   @id @default(cuid())
  template_key    String
  version         Int
  subject         String?
  content         String
  is_active       Boolean  @default(false)
  createdAt       DateTime @default(now())
  organization_id String   @default("org_historical_broceliande")

  @@unique([organization_id, template_key, version], map: "content_template_versions_org_key_version_key")
  @@index([template_key, is_active], map: "content_template_versions_active_idx")
  @@map("content_template_versions")
}

model Gite {
  id                                  String    @id @default(cuid())
  ordre                               Int       @default(0)
  nom                                 String
  nom_avec_preposition                String?
  prefixe_contrat                     String
  adresse_ligne1                      String
  adresse_ligne2                      String?
  capacite_max                        Int
  nb_adultes_max                      Int       @default(1)
  nb_adultes_habituel                 Int       @default(1)
  nb_enfants_max                      Int       @default(0)
  proprietaires_noms                  String
  proprietaires_adresse               String
  site_web                            String?
  public_slug                         String?
  public_translations                 Json?
  public_title                        String?
  public_summary                      String?
  public_description                  String?
  public_technical_description        String?
  public_seo_title                    String?
  public_seo_description              String?
  public_is_published                 Boolean   @default(false)
  public_structured_content           Json?
  public_equipment                    Json?
  public_rooms                        Json?
  public_practical_info               Json?
  public_location_info                Json?
  public_web_info                     Json?
  public_latitude                     Decimal?  @db.Decimal(9, 6)
  public_longitude                    Decimal?  @db.Decimal(9, 6)
  email                               String?
  telephones                          Json
  taxe_sejour_par_personne_par_nuit   Decimal   @db.Decimal(10, 2)
  iban                                String
  bic                                 String?
  titulaire                           String
  regle_animaux_acceptes              Boolean   @default(false)
  regle_bois_premiere_flambee         Boolean   @default(false)
  regle_tiers_personnes_info          Boolean   @default(false)
  options_draps_par_lit               Decimal   @default(0) @db.Decimal(10, 2)
  options_linge_toilette_par_personne Decimal   @default(0) @db.Decimal(10, 2)
  options_menage_forfait              Decimal   @default(0) @db.Decimal(10, 2)
  options_depart_tardif_forfait       Decimal   @default(0) @db.Decimal(10, 2)
  options_chiens_forfait              Decimal   @default(0) @db.Decimal(10, 2)
  heure_arrivee_defaut                String    @default("17:00")
  heure_depart_defaut                 String    @default("12:00")
  caution_montant_defaut              Decimal   @default(0) @db.Decimal(10, 2)
  cheque_menage_montant_defaut        Decimal   @default(0) @db.Decimal(10, 2)
  arrhes_taux_defaut                  Decimal   @default(0.2) @db.Decimal(5, 4)
  electricity_price_per_kwh           Decimal   @default(0) @db.Decimal(10, 4)
  prix_intervention                   Decimal   @default(0) @db.Decimal(10, 2)
  frais_gestion                       Json?
  prix_nuit_basse_saison              Decimal   @default(0) @db.Decimal(10, 2)
  prix_nuit_haute_saison              Decimal   @default(0) @db.Decimal(10, 2)
  min_nuits_toute_annee               Int       @default(1)
  min_nuits_vacances_scolaires        Int       @default(1)
  min_nuits_juillet_aout              Int       @default(1)
  prix_nuit_liste                     Json?
  caracteristiques                    String?
  airbnb_listing_id                   String?
  ical_export_token                   String?
  gestionnaire_id                     String?
  date_debut_activite                 DateTime?
  createdAt                           DateTime  @default(now())
  updatedAt                           DateTime  @updatedAt
  organization_id                     String    @default("org_historical_broceliande")

  gestionnaire             Gestionnaire?              @relation(fields: [gestionnaire_id], references: [id], onDelete: SetNull)
  ical_sources             IcalSource[]
  contrats                 Contrat[]
  factures                 Facture[]
  reservations             Reservation[]
  guest_night_declarations GuestNightDeclaration[]
  monthly_energy_readings  GiteMonthlyEnergyReading[]
  season_rates             GiteSeasonRate[]
  booking_requests         BookingRequest[]
  photos                   GitePhoto[]
  wordpress_photo_sync_job WordPressWebhookJob?
  counters                 ContratCounter[]
  facture_counters         FactureCounter[]
  expense_recurring_rules  ExpenseRecurringRule[]
  expense_entries          ExpenseEntry[]
  intervenant_expenses     IntervenantExpense[]
  user_interventions       UserIntervention[]

  @@unique([organization_id, public_slug], map: "gites_org_public_slug_key")
  @@index([gestionnaire_id], map: "gites_gestionnaire_id_idx")
  @@index([ical_export_token], map: "gites_ical_export_token_idx")
  @@index([ordre], map: "gites_ordre_idx")
  @@index([public_is_published, ordre], map: "gites_public_published_ordre_idx")
  @@map("gites")
}

model GitePhoto {
  id              String   @id @default(cuid())
  gite_id         String
  url             String
  title           String?
  alt             String?
  credit          String?
  is_primary      Boolean  @default(false)
  is_public       Boolean  @default(true)
  ordre           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization_id String   @default("org_historical_broceliande")

  gite Gite @relation(fields: [gite_id], references: [id], onDelete: Cascade)

  @@index([gite_id, ordre], map: "gite_photos_gite_ordre_idx")
  @@index([gite_id, is_public, ordre], map: "gite_photos_public_ordre_idx")
  @@map("gite_photos")
}

model WordPressWebhookJob {
  id              String    @id @default(cuid())
  gite_id         String    @unique
  event           String    @default("gite.photos.saved")
  state           String    @default("queued")
  generation      Int       @default(0)
  attempts        Int       @default(0)
  max_attempts    Int       @default(3)
  run_after       DateTime
  queued_at       DateTime  @default(now())
  sent_at         DateTime?
  completed_at    DateTime?
  response_status Int?
  response_body   String?
  last_error      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  organization_id String    @default("org_historical_broceliande")

  gite Gite @relation(fields: [gite_id], references: [id], onDelete: Cascade)

  @@index([state, run_after], map: "wordpress_webhook_jobs_state_run_after_idx")
  @@map("wordpress_webhook_jobs")
}

model Gestionnaire {
  id              String   @id @default(cuid())
  prenom          String
  nom             String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organization_id String   @default("org_historical_broceliande")

  gites                   Gite[]
  urssaf_declarations     UrssafDeclaration[]
  expense_recurring_rules ExpenseRecurringRule[]
  expense_entries         ExpenseEntry[]
  app_user                AppUser?

  @@unique([organization_id, prenom, nom])
  @@map("gestionnaires")
}

model AppUser {
  id                  String    @id @default(cuid())
  display_name        String
  first_name          String    @default("")
  last_name           String    @default("")
  roles               String    @default("[]")
  telephone           String?
  email               String?
  adresse             String?
  telegram_chat_id    String?
  hourly_rate         Decimal   @default(0) @db.Decimal(10, 2)
  cleaning_check_rate Decimal   @default(0) @db.Decimal(10, 2)
  full_cleaning_rate  Decimal   @default(0) @db.Decimal(10, 2)
  gestionnaire_id     String?   @unique
  intervenant_id      String?   @unique
  status              String    @default("custom")
  page_access         Json      @default("[]")
  can_write           Boolean   @default(true)
  can_view_amounts    Boolean   @default(true)
  is_owner            Boolean   @default(false)
  is_active           Boolean   @default(true)
  login_id            String?   @unique
  password_hash       String?
  password_salt       String?
  password_updated_at DateTime?
  auth_version        Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  organization_id     String    @default("org_historical_broceliande")
  user_id             String?

  gestionnaire              Gestionnaire?        @relation(fields: [gestionnaire_id], references: [id], onDelete: SetNull)
  intervenant               PlanningRelayWorker? @relation(fields: [intervenant_id], references: [id], onDelete: SetNull)
  arrival_cleaning_checks   Reservation[]        @relation("ArrivalCleaningCheckedBy")
  departure_cleaning_checks Reservation[]        @relation("DepartureCleaningCheckedBy")
  interventions             UserIntervention[]
  auth_sessions             AuthSession[]
  password_reset_tokens     PasswordResetToken[]
  global_user               User?                @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@unique([organization_id, user_id], map: "app_users_org_user_key")
  @@index([organization_id, is_active, display_name], map: "app_users_org_active_name_idx")
  @@map("app_users")
}

model PasswordResetToken {
  id         String    @id
  user_id    String
  created_at DateTime  @default(now())
  expires_at DateTime
  used_at    DateTime?

  user AppUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, used_at, expires_at], map: "password_reset_tokens_user_active_idx")
  @@index([expires_at], map: "password_reset_tokens_expires_idx")
  @@map("password_reset_tokens")
}

model AuthSession {
  id              String    @id
  user_id         String
  auth_version    Int
  created_at      DateTime  @default(now())
  expires_at      DateTime
  revoked_at      DateTime?
  last_seen_at    DateTime  @default(now())
  organization_id String    @default("org_historical_broceliande")

  user AppUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, revoked_at, expires_at], map: "auth_sessions_user_active_idx")
  @@index([expires_at], map: "auth_sessions_expires_idx")
  @@map("auth_sessions")
}

model ApiToken {
  id              String    @id @default(cuid())
  name            String
  token_hash      String    @unique
  scopes          String    @default("[]")
  expires_at      DateTime?
  revoked_at      DateTime?
  last_used_at    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  organization_id String    @default("org_historical_broceliande")

  @@index([revoked_at, expires_at], map: "api_tokens_active_idx")
  @@map("api_tokens")
}

model DocumentShare {
  id              String    @id @default(cuid())
  token_hash      String    @unique
  document_type   String
  document_id     String
  expires_at      DateTime
  revoked_at      DateTime?
  access_count    Int       @default(0)
  last_access_at  DateTime?
  created_by_id   String?
  createdAt       DateTime  @default(now())
  organization_id String    @default("org_historical_broceliande")

  @@index([document_type, document_id, revoked_at], map: "document_shares_document_idx")
  @@index([expires_at], map: "document_shares_expires_idx")
  @@map("document_shares")
}

model AppUserStatusPreset {
  status           String   @id
  page_access      Json     @default("[]")
  can_write        Boolean  @default(false)
  can_view_amounts Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  @@map("app_user_status_presets")
}

model ExpenseCategory {
  id              String   @id @default(cuid())
  name            String
  color           String
  scope           String   @default("both")
  ordre           Int      @default(0)
