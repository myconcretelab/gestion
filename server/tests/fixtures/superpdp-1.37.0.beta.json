    "/v1.beta/invoices/convert": {
      "post": {
        "operationId": "ConvertInvoice",
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/convert_invoice_format"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/convert_invoice_format"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/en_invoice"
              }
            },
            "application/xml": {},
            "multipart/form-data": {
              "encoding": {
                "invoice": {
                  "contentType": "application/json, application/xml"
                },
                "pdf": {
                  "contentType": "application/pdf"
                }
              },
              "schema": {
                "properties": {
                  "invoice": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/en_invoice"
                      },
                      {
                        "format": "binary",
                        "type": "string"
                      }
                    ]
                  },
                  "pdf": {
                    "format": "binary",
                    "type": "string"
                  }
                },
                "required": [
                  "pdf",
                  "invoice"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/en_invoice"
                }
              },
              "application/xml": {}
            }
          },
          "400": {
            "$ref": "#/components/responses/bad_request"
          },
          "500": {
            "$ref": "#/components/responses/internal_server_error"
          }
        },
        "security": []
      }
    },
