    "/v1.beta/invoices": {
      "get": {
        "operationId": "InvoicesList",
        "parameters": [
          {
            "in": "query",
            "name": "direction",
            "schema": {
              "$ref": "#/components/schemas/direction"
            }
          },
          {
            "in": "query",
            "name": "date",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "order",
            "schema": {
              "default": "asc",
              "enum": ["asc", "desc"],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "starting_after_id",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "ending_before_id",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 100,
              "maximum": 1000,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "expand[]",
            "schema": {
              "items": {
                "enum": [
                  "en_invoice",
                  "en_invoice.invoice",
                  "en_invoice.seller",
                  "en_invoice.buyer",
                  "en_invoice.notes",
                  "en_invoice.preceding_invoice_references",
                  "en_invoice.buyer_agent",
                  "en_invoice.payee",
                  "en_invoice.payer",
                  "en_invoice.seller_agent",
                  "en_invoice.addressed_to",
                  "en_invoice.third_party_biller",
                  "en_invoice.delivery_information",
                  "en_invoice.deliver_to_address",
                  "en_invoice.payment_instructions",
                  "en_invoice.document_level_allowances",
                  "en_invoice.document_level_charges",
                  "en_invoice.vat_break_down",
                  "en_invoice.additional_supporting_documents",
                  "en_invoice.lines",
                  "events"
                ],
                "type": "string"
              },
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/list_invoices"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/bad_request"
          },
          "500": {
            "$ref": "#/components/responses/internal_server_error"
          }
        }
      },
      "post": {
        "operationId": "InvoicesCreate",
        "parameters": [
          {
            "in": "query",
            "name": "external_id",
            "schema": {
              "maxLength": 36,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "disable_pre_check",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "processing_rule",
            "schema": {
              "$ref": "#/components/schemas/processing_rule"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/pdf": {},
            "application/xml": {},
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file_name": {
                    "format": "binary",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/invoice"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/bad_request"
          },
          "500": {
            "$ref": "#/components/responses/internal_server_error"
          }
        }
      }
    },
    "/v1.beta/invoices/{id}": {
      "get": {
        "operationId": "InvoicesGet",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "format",
            "schema": {
              "default": "en16931",
              "enum": ["en16931", "original", "cii", "ubl", "factur-x"],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "force_superpdp_pdf_renderer",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/invoice"
                }
              },
              "application/pdf": {},
              "application/xml": {}
            }
          },
          "400": {
            "$ref": "#/components/responses/bad_request"
          },
          "500": {
            "$ref": "#/components/responses/internal_server_error"
          }
        }
      }
    },
    "/v1.beta/invoice_events": {
      "get": {
        "operationId": "InvoiceEventsList",
