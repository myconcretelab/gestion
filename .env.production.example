# Production générique derrière un proxy HTTPS
NODE_ENV=production
PORT=4000
CLIENT_ORIGIN=https://locations.example.com
TRUST_PROXY=true
REQUEST_BODY_LIMIT=20mb
DATABASE_URL="postgresql://rental_manager:CHANGE_ME@db.example.com:5432/rental_manager?schema=public&sslmode=require"
DATA_DIR=/srv/rental-manager/data
PDF_SUBDIR=pdfs
CLIENT_DIST_DIR=/srv/rental-manager/client/dist
PLAYWRIGHT_BROWSERS_PATH=/srv/rental-manager/.cache/ms-playwright

# Assistant initial : générer une valeur aléatoire de 32 octets et la retirer après l'installation.
SETUP_TOKEN=
# 24 caractères minimum, conservée séparément des archives PostgreSQL.
INSTALLATION_BACKUP_PASSPHRASE=
BOOTSTRAP_ADMIN_LOGIN=
BOOTSTRAP_ADMIN_PASSWORD=

# Intégrations facultatives. Ne renseigner que celles dont le module est activé.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=
SMS_APP_KEY=
SMS_SECRET=
SMS_CONSUMER_KEY=
SMS_SERVICE_NAME=
SMS_SENDER=
CRON_TRIGGER_TOKEN=
BOOKED_WORDPRESS_WEBHOOK_URL=
BOOKED_WORDPRESS_WEBHOOK_SECRET=
PUMP_API_BASE_URL=
PUMP_API_KEY=
PUMP_BASE_URL=https://www.airbnb.com/hosting/multicalendar
PUMP_USERNAME=
PUMP_SESSION_PASSWORD=
PLANNING_RELAY_SHARE_SECRET=
SECURITY_THROTTLE_SECRET=
