{
  "name": "contrats-monorepo",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "server",
    "client",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w @contrats/shared && npm run build -w client && npm run build -w server",
    "test": "npm run test -w @contrats/shared && npm run test -w server && npm run test -w client",
    "typecheck": "npm run build -w @contrats/shared && npm run build -w server && npm run typecheck -w client",
    "lint": "eslint \"server/src/**/*.ts\" \"client/src/**/*.{ts,tsx}\" \"packages/shared/src/**/*.ts\" && npm run lint:architecture -w server && npm run lint -w @contrats/shared",
    "format": "prettier --write \"server/src/modules/**/*.ts\" \"client/src/features/**/*.ts\" \"packages/shared/**/*.{ts,json}\"",
    "format:check": "prettier --check \"server/src/modules/**/*.ts\" \"client/src/features/**/*.ts\" \"packages/shared/**/*.{ts,json}\"",
    "test:e2e": "npm run test:e2e -w server",
    "start": "npm run start -w server",
    "migrate": "npm run migrate -w server",
    "update": "bash ./update",
    "seed": "npm run seed -w server",
    "dev:db": "npm run dev:db -w server",
    "dev:reset": "npm run dev:reset -w server",
    "prod:migrate": "npm run prod:migrate -w server",
    "prod:generate": "npm run prod:generate -w server",
    "cron:ical": "npm run cron:ical -w server",
    "db:studio": "npm run db:studio -w server",
    "prisma:generate": "npm run prisma:generate -w server",
    "prisma:use:sqlite": "npm run prisma:use:sqlite -w server",
    "prisma:use:postgres": "npm run prisma:use:postgres -w server",
    "db:migrate:sqlite-to-postgres": "npm run db:migrate:sqlite-to-postgres -w server",
    "backup": "node server/scripts/installation-data.mjs backup",
    "restore:preview": "node server/scripts/installation-data.mjs preview",
    "restore": "node server/scripts/installation-data.mjs restore"
  },
  "overrides": {
    "proxy-addr": "$proxy-addr",
    "qs": "$qs",
    "c12": {
      "defu": "^6.1.7"
    },
    "concurrently": {
      "lodash": "^4.18.1"
    },
    "express": {
      "proxy-addr": "$proxy-addr",
      "qs": "$qs"
    },
    "vite": {
      "rollup": "^4.60.1"
    }
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.71.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "body-parser": "1.20.6",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0"
  }
}
